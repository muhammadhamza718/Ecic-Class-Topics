        "print(\"==============================\")\n",
        "print(\"KASHMIR DAY EVENT MANAGER\")\n",
        "print(\"==============================\")\n",
        "\n",
        "camp_name = input(\"Enter Camp Name: \")\n",
        "budget = float(input(\"Enter Budget: \"))\n",
        "\n",
        "cities = [\"Muzaffarabad\", \"Mirpur\", \"Rawalakot\"]\n",
        "print(\"Cities:\", cities)\n",
        "\n",
        "new_city = input(\"Enter a new city: \")\n",
        "cities.append(new_city)\n",
        "print(\"Total Cities:\", len(cities))\n",
        "\n",
        "items = [\"Banners\", \"Flags\", \"Sound System\"]\n",
        "prices = [1500, 800, 5000]\n",
        "\n",
        "total_cost = sum(prices)\n",
        "print(\"Total Cost:\", total_cost)\n",
        "\n",
        "if budget >= total_cost:\n",
        "    print(\"Status: You have enough money\")\n",
        "    if budget - total_cost > 5000:\n",
        "        print(\"You can buy a Digital Screen now\")\n",
        "        items.append(\"Digital Screen\")\n",
        "        prices.append(4500)\n",
        "else:\n",
        "    print(\"Status: Not enough money\")\n",
        "    items.pop()\n",
        "    prices.pop()\n",
        "    print(\"One item removed to save money\")\n",
        "\n",
        "print(\"Final Camp Details\")\n",
        "print(\"Name:\", camp_name)\n",
        "print(\"Total Items:\", len(items))\n",
        "print(\"Total Expense:\", sum(prices))\n",
        "print(\"Money Left:\", budget - sum(prices))"
      ]
    }
