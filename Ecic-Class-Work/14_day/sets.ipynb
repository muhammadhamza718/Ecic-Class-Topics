   "source": [
    "## Python Sets\n",
    "\n",
    "Symmetric diff without using built-in methods"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 2,
   "id": "c58d7192",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Symmetric Difference: {1, 2, 5, 6}\n"
     ]
    }
   ],
   "source": [
    "set1 = {1, 2, 3, 4}\n",
    "set2 = {3, 4, 5, 6}\n",
    "\n",
    "sym_diff = (set1 - set2) | (set2 - set1)\n",
    "print(\"Symmetric Difference:\", sym_diff)"
   ]
  }
