   "source": [
    "import random\n",
    "\n",
    "print(\"\"\"\n",
    "Welcome to Nim!\n",
    "There are 7 sticks on the table.\n",
    "You can pick up 1, 2, or 3 sticks per turn.\n",
    "The player who picks up the last stick LOSES.\n",
    "\"\"\")\n",
    "\n",
    "sticks = 7\n",
    "winner = None\n",
    "\n",
    "order = input(\"Do you want to go first or second? (first/second): \").strip().lower()\n",
    "\n",
    "if order == \"second\":\n",
    "    computer_first = 2\n",
    "    sticks -= computer_first\n",
    "    print(f\"\\nComputer goes first and takes {computer_first} stick(s).\")\n",
    "    print(f\"Sticks remaining: {sticks}\\n\")\n",
    "\n",
    "while winner is None:\n",
    "    while True:\n",
    "        try:\n",
    "            user_choice = int(input(f\"Sticks on table: {sticks}. How many do you take? (1/2/3): \"))\n",
    "            if user_choice not in [1, 2, 3]:\n",
    "                print(\"Invalid choice. Please pick 1, 2, or 3.\")\n",
    "            elif user_choice > sticks:\n",
    "                print(f\"Not enough sticks! Only {sticks} left.\")\n",
    "            else:\n",
    "                break\n",
    "        except ValueError:\n",
    "            print(\"Please enter a valid number.\")\n",
    "\n",
    "    sticks -= user_choice\n",
    "    print(f\"You took {user_choice} stick(s). Sticks remaining: {sticks}\")\n",
    "\n",
    "    if sticks == 0:\n",
    "        winner = \"Computer\"\n",
    "        print(\"\\nYou picked the last stick. You LOSE! Computer wins!\")\n",
    "        break\n",
    "\n",
    "    ideal = sticks % 4\n",
    "    if ideal == 0:\n",
    "        computer_choice = random.choice([1, 2, 3])\n",
    "    else:\n",
    "        computer_choice = ideal\n",
    "\n",
    "    computer_choice = max(1, min(3, computer_choice))\n",
    "    computer_choice = min(computer_choice, sticks)\n",
    "\n",
    "    sticks -= computer_choice\n",
    "    print(f\"Computer takes {computer_choice} stick(s). Sticks remaining: {sticks}\\n\")\n",
    "\n",
    "    if sticks == 0:\n",
    "        winner = \"Player\"\n",
    "        print(\"Computer picked the last stick. YOU WIN!\")\n",
    "        break\n",
    "\n",
    "print(f\"\\nGame over! Winner: {winner}\")"
   ]
