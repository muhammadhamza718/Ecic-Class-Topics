   ],
   "source": [
    "result = 0\n",
    "for i in range(1, 6):\n",
    "    if i%2 == 0:\n",
    "        result += i\n",
    "    print(f\"subtracted {i}: Current total is {result}\")\n",
    "else:\n",
    "    result = result + i\n",
    "    print(f\"added {i}: Current total is {result}\")"
   ]
  },
